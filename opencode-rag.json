{
  "embedding": {
    "timeoutMs": 30000
  },
  "indexing": {
    "includeExtensions": [
      ".ver",
      ".comments",
      ".srvscr",
      ".clientscript",
      ".xml",
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".py",
      ".java",
      ".go",
      ".md",
      ".mdx",
      ".c",
      ".h",
      ".cpp",
      ".cc",
      ".cxx",
      ".hpp",
      ".hxx",
      ".cs",
      ".aspx",
      ".razor",
      ".cshtml",
      ".json",
      ".html",
      ".htm",
      ".css",
      ".csproj",
      ".sln",
      ".rs",
      ".rb",
      ".kt",
      ".kts",
      ".swift",
      ".tex",
      ".pdf",
      ".docx",
      ".doc",
      ".xls",
      ".xlsx",
      ".sh",
      ".bash",
      ".zsh",
      ".png",
      ".php",
      ".ps1",
      ".psm1",
      ".psd1",
      ".ini",
      ".cfg",
      ".yaml",
      ".yml",
      ".toml",
      ".sql",
      ".ssl",
      ".jpg",
      ".jpeg",
      ".gif",
      ".bmp",
      ".svg",
      ".webp",
      "dockerfile",
      "containerfile",
      ".dockerfile",
      ".containerfile"
    ],
    "excludeExtensions": [
      ".map",
      ".lock",
      ".log",
      ".tmp",
      ".temp",
      ".bak",
      ".backup",
      ".swp",
      ".swo",
      ".DS_Store",
      ".thumbs.db",
      ".sdp",
      ".vsix"
    ],
    "excludeDirs": [
      "out-lsp-test",
      "out",
      ".vscode-test",
      "node_modules",
      ".git",
      ".opencode",
      "dist",
      "build",
      "__pycache__",
      ".venv",
      ".claude",
      ".github",
      "memory:",
      "wasm",
      ".commandcode",
      ".agents",
      "graphify-out",
      ".vscode",
      ".vs",
      ".idea",
      ".next",
      ".nuxt",
      ".turbo",
      ".angular",
      ".svelte-kit",
      ".gradle",
      ".dart_tool",
      ".cache"
    ],
    "chunkOverlap": 0,
    "minFileSizeBytes": 0,
    "concurrency": 8,
    "embedBatchSize": 40,
    "embedConcurrency": 4,
    "ollamaMaxBatchSize": 40
  },
  "vectorStore": {
    "path": "./.opencode/rag_ch"
  },
  "retrieval": {
    "topK": 20,
    "minScore": 0.35,
    "hybridSearch": {
      "enabled": true,
      "keywordWeight": 0.4
    }
  },
  "openCode": {
    "enabled": true,
    "maxContextChunks": 10,
    "readOverride": true,
    "autoIndex": {
      "enabled": true,
      "debounceMs": 2000,
      "intervalMs": 300000,
      "watcher": "chokidar"
    }
  },
  "imageDescription": {
    "enabled": true,
    "timeoutMs": 60000,
    "think": false,
    "numCtx": 2048
  },
  "description": {
    "enabled": true,
    "think": false,
    "numCtx": 4096,
    "timeoutMs": 60000,
    "maxContentChars": 4000
  },
  "wikiMode": {
    "enabled": true
  },
  "mcp": {
    "enabled": false
  },
  "logging": {
    "level": "info",
    "logFilePath": "./.opencode/opencode-rag.log"
  }
}