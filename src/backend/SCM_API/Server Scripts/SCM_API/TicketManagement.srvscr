:PROCEDURE AddCompletedMeasure;
:PARAMETERS nTicketId, sMeasureTitle, sMeasureDescription;
:DEFAULT nTicketId, -1;
:DEFAULT sMeasureTitle, "";
:DEFAULT sMeasureDescription, "";

SQLExecute(
"INSERT INTO BMBH_TICKET_MEASURES (TICKET_ID, TITLE, DESCRIPTION, STATUS, PRIORITY, DATE_FINISHED)
VALUES (?nTicketId?, ?sMeasureTitle?, ?sMeasureDescription?, 'Completed', 0, GETDATE())");

:DECLARE nMeasureId;
nMeasureId := SQLExecute("SELECT @@IDENTITY");
:RETURN nMeasureId;
:ENDPROC;

:PROCEDURE SetTicketInProgress;
:PARAMETERS nTicketId, sUsername;
:DEFAULT nTicketId, -1;
:DEFAULT sUsername, "";

:IF nTicketId < 0;
	RaiseError("TicketId must be provided.", "SCM_API.TicketManagement.SetTicketInProgress", -1);
:ENDIF;

:IF Empty(AllTrim(sUsername));
	RaiseError("Username must be provided.", "SCM_API.TicketManagement.SetTicketInProgress", -1);
:ENDIF;

:DECLARE nInProgressCode;
nInProgressCode := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_STATUS WHERE STATUS_NAME = 'In Bearbeitung'");

:IF Empty(nInProgressCode) .OR. Len(nInProgressCode) == 0;
	RaiseError("Could not resolve ticket status 'In Bearbeitung'.", "SCM_API.TicketManagement.SetTicketInProgress", -1);
:ENDIF;

nInProgressCode := nInProgressCode[1][1];

SQLExecute("UPDATE BMBH_TICKETS SET STATUS = ?nInProgressCode?, ASIGNEDTO = ?sUsername?, MODIFIEDON = GETDATE() WHERE ORIGREC = ?nTicketId?");

:RETURN nInProgressCode;
:ENDPROC;

:PROCEDURE SetTicketOpen;
:PARAMETERS nTicketId;
:DEFAULT nTicketId, -1;

:IF nTicketId < 0;
	RaiseError("TicketId must be provided.", "SCM_API.TicketManagement.SetTicketOpen", -1);
:ENDIF;

:DECLARE nOpenCode;
nOpenCode := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_STATUS WHERE STATUS_NAME = 'Offen'");

:IF Empty(nOpenCode) .OR. Len(nOpenCode) == 0;
	RaiseError("Could not resolve ticket status 'Offen'.", "SCM_API.TicketManagement.SetTicketOpen", -1);
:ENDIF;

nOpenCode := nOpenCode[1][1];

SQLExecute("UPDATE BMBH_TICKETS SET STATUS = ?nOpenCode?, ASIGNEDTO = '', MODIFIEDON = GETDATE() WHERE ORIGREC = ?nTicketId?");

:RETURN nOpenCode;
:ENDPROC;

:PROCEDURE SetTicketFertig;
:PARAMETERS nTicketId;
:DEFAULT nTicketId, -1;

:IF nTicketId < 0;
	RaiseError("TicketId must be provided.", "SCM_API.TicketManagement.SetTicketFertig", -1);
:ENDIF;

:DECLARE nFertigCode;
nFertigCode := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_STATUS WHERE STATUS_NAME = 'Fertig'");

:IF Empty(nFertigCode) .OR. Len(nFertigCode) == 0;
	RaiseError("Could not resolve ticket status 'Fertig'.", "SCM_API.TicketManagement.SetTicketFertig", -1);
:ENDIF;

nFertigCode := nFertigCode[1][1];

SQLExecute("UPDATE BMBH_TICKETS SET STATUS = ?nFertigCode?, ASIGNEDTO = '', MODIFIEDON = GETDATE() WHERE ORIGREC = ?nTicketId?");

:RETURN nFertigCode;
:ENDPROC;

:PROCEDURE RenameTicket;
:PARAMETERS nTicketId, sNewTitle;
:DEFAULT nTicketId, -1;
:DEFAULT sNewTitle, "";

:IF nTicketId < 0;
	RaiseError("TicketId must be provided.", "SCM_API.TicketManagement.RenameTicket", -1);
:ENDIF;

:IF Empty(AllTrim(sNewTitle));
	RaiseError("New title must be provided.", "SCM_API.TicketManagement.RenameTicket", -1);
:ENDIF;

SQLExecute("UPDATE BMBH_TICKETS SET TITLE = ?sNewTitle?, MODIFIEDON = GETDATE() WHERE ORIGREC = ?nTicketId?");

:RETURN 1;
:ENDPROC;

:PROCEDURE GetTicketLookupData;
:DECLARE oResponse;
oResponse := CreateUDObject({
	{"statuses", NIL},
	{"types", NIL},
	{"priorities", NIL},
	{"severities", NIL}
});

/* Static ticket dictionaries, returned as arrays of [ORIGREC, NAME] so clients can resolve names to codes.;
oResponse:statuses := SQLExecute("SELECT ORIGREC, STATUS_NAME FROM BMBH_TICKET_STATUS ORDER BY ORIGREC");
oResponse:types := SQLExecute("SELECT ORIGREC, TYPE_NAME FROM BMBH_TICKET_TYPE ORDER BY ORIGREC");
oResponse:priorities := SQLExecute("SELECT ORIGREC, PRIORITY_NAME FROM BMBH_TICKET_PRIORITY ORDER BY ORIGREC");
oResponse:severities := SQLExecute("SELECT ORIGREC, SEVERITY_NAME FROM BMBH_TICKET_SEVERITY ORDER BY ORIGREC");

:RETURN oResponse;
:ENDPROC;

:PROCEDURE GetTicketMeasures;
:PARAMETERS nTicketId;
:DEFAULT nTicketId, -1;

:IF nTicketId < 0;
	RaiseError("TicketId must be provided.", "SCM_API.TicketManagement.GetTicketMeasures", -1);
:ENDIF;

/* Recorded measures of one ticket, newest first - ORIGSTS is deliberately not filtered because its default constraint writes N for every inserted row;
:DECLARE aMeasures;
aMeasures := SQLExecute("SELECT ORIGREC, TITLE, DESCRIPTION, STATUS, PRIORITY, TICKET_ID, DATE_FINISHED FROM BMBH_TICKET_MEASURES WHERE TICKET_ID = ?nTicketId? ORDER BY ORIGREC DESC");

:RETURN aMeasures;
:ENDPROC;

:PROCEDURE GetTicketComments;
:PARAMETERS nTicketId;
:DEFAULT nTicketId, -1;

:IF nTicketId < 0;
	RaiseError("TicketId must be provided.", "SCM_API.TicketManagement.GetTicketComments", -1);
:ENDIF;

/* Comments of one ticket, oldest first - ORIGSTS is deliberately not filtered because its default constraint writes N for every inserted row;
:DECLARE aComments;
aComments := SQLExecute("SELECT ORIGREC, COMMENT_TEXT, AUTHOR, CREATED_ON FROM BMBH_TICKET_COMMENTS WHERE TICKET_ID = ?nTicketId? ORDER BY CREATED_ON ASC, ORIGREC ASC");

:RETURN aComments;
:ENDPROC;

:PROCEDURE UpdateMeasure;
:PARAMETERS nTicketId, nMeasureId, sMeasureTitle, sMeasureDescription, nUpdateDescription;
:DEFAULT nTicketId, -1;
:DEFAULT nMeasureId, -1;
:DEFAULT sMeasureTitle, "";
:DEFAULT sMeasureDescription, "";
:DEFAULT nUpdateDescription, 1;

:IF nMeasureId < 0;
	RaiseError("MeasureId must be provided.", "SCM_API.TicketManagement.UpdateMeasure", -1);
:ENDIF;

:IF Empty(AllTrim(sMeasureTitle));
	RaiseError("Measure title must be provided.", "SCM_API.TicketManagement.UpdateMeasure", -1);
:ENDIF;

:DECLARE aMeasureRows;
aMeasureRows := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_MEASURES WHERE ORIGREC = ?nMeasureId? AND TICKET_ID = ?nTicketId?");

:IF Empty(aMeasureRows) .OR. Len(aMeasureRows) == 0;
	RaiseError("Measure not found for this ticket.", "SCM_API.TicketManagement.UpdateMeasure", -1);
:ENDIF;

/* nUpdateDescription = 0 keeps the stored description - the client omits the description then - a number, not a boolean, because the client sends 0/1;
:IF nUpdateDescription == 1;
	SQLExecute("UPDATE BMBH_TICKET_MEASURES SET TITLE = ?sMeasureTitle?, DESCRIPTION = ?sMeasureDescription? WHERE ORIGREC = ?nMeasureId? AND TICKET_ID = ?nTicketId?");
:ELSE;
	SQLExecute("UPDATE BMBH_TICKET_MEASURES SET TITLE = ?sMeasureTitle? WHERE ORIGREC = ?nMeasureId? AND TICKET_ID = ?nTicketId?");
:ENDIF;

:RETURN 1;
:ENDPROC;

:PROCEDURE DeleteMeasure;
:PARAMETERS nTicketId, nMeasureId;
:DEFAULT nTicketId, -1;
:DEFAULT nMeasureId, -1;

:IF nMeasureId < 0;
	RaiseError("MeasureId must be provided.", "SCM_API.TicketManagement.DeleteMeasure", -1);
:ENDIF;

:DECLARE aMeasureRows;
aMeasureRows := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_MEASURES WHERE ORIGREC = ?nMeasureId? AND TICKET_ID = ?nTicketId?");

:IF Empty(aMeasureRows) .OR. Len(aMeasureRows) == 0;
	RaiseError("Measure not found for this ticket.", "SCM_API.TicketManagement.DeleteMeasure", -1);
:ENDIF;

SQLExecute("DELETE FROM BMBH_TICKET_MEASURES WHERE ORIGREC = ?nMeasureId? AND TICKET_ID = ?nTicketId?");

:RETURN 1;
:ENDPROC;

:PROCEDURE UpdateComment;
:PARAMETERS nTicketId, nCommentId, sCommentText;
:DEFAULT nTicketId, -1;
:DEFAULT nCommentId, -1;
:DEFAULT sCommentText, "";

:IF nCommentId < 0;
	RaiseError("CommentId must be provided.", "SCM_API.TicketManagement.UpdateComment", -1);
:ENDIF;

:IF Empty(AllTrim(sCommentText));
	RaiseError("Comment text must be provided.", "SCM_API.TicketManagement.UpdateComment", -1);
:ENDIF;

:DECLARE aCommentRows;
aCommentRows := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_COMMENTS WHERE ORIGREC = ?nCommentId? AND TICKET_ID = ?nTicketId?");

:IF Empty(aCommentRows) .OR. Len(aCommentRows) == 0;
	RaiseError("Comment not found for this ticket.", "SCM_API.TicketManagement.UpdateComment", -1);
:ENDIF;

SQLExecute("UPDATE BMBH_TICKET_COMMENTS SET COMMENT_TEXT = ?sCommentText? WHERE ORIGREC = ?nCommentId? AND TICKET_ID = ?nTicketId?");

:RETURN 1;
:ENDPROC;

:PROCEDURE DeleteComment;
:PARAMETERS nTicketId, nCommentId;
:DEFAULT nTicketId, -1;
:DEFAULT nCommentId, -1;

:IF nCommentId < 0;
	RaiseError("CommentId must be provided.", "SCM_API.TicketManagement.DeleteComment", -1);
:ENDIF;

:DECLARE aCommentRows;
aCommentRows := SQLExecute("SELECT ORIGREC FROM BMBH_TICKET_COMMENTS WHERE ORIGREC = ?nCommentId? AND TICKET_ID = ?nTicketId?");

:IF Empty(aCommentRows) .OR. Len(aCommentRows) == 0;
	RaiseError("Comment not found for this ticket.", "SCM_API.TicketManagement.DeleteComment", -1);
:ENDIF;

SQLExecute("DELETE FROM BMBH_TICKET_COMMENTS WHERE ORIGREC = ?nCommentId? AND TICKET_ID = ?nTicketId?");

:RETURN 1;
:ENDPROC;