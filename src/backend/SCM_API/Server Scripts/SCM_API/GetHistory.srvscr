/******************************************************************************
Description.. :	Get the version history of an Enterprise item from LIMSSOURCECONTROL
					Joined with LIMSVERSIONS for the MAJOR.MINOR.BUILD version number.
					Rows are metadata only (no code documents) - use GetHistoryCode
					to read the code snapshot of a single version.
Author....... :	DC
Date......... : 2026-10-16
*******************************************************************************/;
:DECLARE String, oResponse, oResult, sURI, oUtils, oEnterpriseItem, sItemID, sItemName,
		 sType, sCategory, sAppName, nMaxItems;
String := "";
oResult := CreateUDObject();
oResponse := CreateUDObject({
	{"success", .T.},
	{"data", NIL}
});

:IF Request:QueryString:IsProperty("URI");
	sURI := Request:QueryString:URI;
:ELSE;
	Response:StatusCode := 400;
	oResponse:success := .F.;
	oResponse:data := String:Format("Missing required parameter: {0}", "URI");
	:RETURN oResponse;
:ENDIF;

nMaxItems := 50;
:IF Request:QueryString:IsProperty("MaxItems");
	nMaxItems := Val(LimsString(Request:QueryString:MaxItems));
:ENDIF;
:IF nMaxItems < 1 .OR. nMaxItems > 500;
	nMaxItems := 50;
:ENDIF;

:TRY;
	oUtils := CreateUDObject("SCM_API.Utils", {});
	oEnterpriseItem := oUtils:ParseURI(sURI);
	sItemName := BuildArray(oEnterpriseItem:Name,, ".")[1];
	sType := oEnterpriseItem:Type;

	:IF oEnterpriseItem:IsProperty("CategoryName");
		sCategory := oEnterpriseItem:CategoryName;
	:ENDIF;

	:IF oEnterpriseItem:IsProperty("AppName");
		sAppName := oEnterpriseItem:AppName;
	:ENDIF;

	sItemID := "";
	:BEGINCASE;
		:CASE sType == "SS" .OR. sType == "CS" .OR. sType == "DS" .OR. sType == "TABLE";
			sItemID := oUtils:GetItemGUID(sCategory + "." + sItemName, sType);
		:EXITCASE;
		:CASE sType == "APPSS" .OR. sType == "APPCS" .OR. sType == "APPDS";
			sItemID := oUtils:GetItemGUID(sAppName + "." + sItemName, sType);
		:EXITCASE;
		:CASE sType == "HTMLFORMXML" .OR. sType == "HTMLFORMCODE" .OR. sType == "HTMLFORMGUIDE" .OR.
			sType == "HTMLFORMRESOURCES" .OR. sType == "XFDFORMXML" .OR. sType == "XFDFORMCODE" .OR.
			sType == "XFDFORMRESOURCES";
			sItemID := oUtils:GetItemGUID(sAppName + "." + sItemName, sType);
		:EXITCASE;
	:ENDCASE;

	:IF Empty(sItemID);
		Response:StatusCode := 400;
		oResponse:success := .F.;
		oResponse:data := "Item not found or item type does not support history: " + sURI;
		:RETURN oResponse;
	:ENDIF;

	/* history rows from the dictionary database;
	:DECLARE sSQL, aHistory, i, aRow, oItem, aItems;
	sSQL := "select top " + LimsString(nMaxItems) + " " +
		"L.VERSIONID, ISNULL(L.DONE, '') AS DONE, " +
		"ISNULL(L.CHECKEDOUTBY, '') AS CHECKEDOUTBY, " +
		"ISNULL(CONVERT(varchar(19), L.CHECKEDOUTDATE, 120), '') AS CHECKEDOUTDATE, " +
		"ISNULL(L.CHECKEDINBY, '') AS CHECKEDINBY, " +
		"ISNULL(CONVERT(varchar(19), L.CHECKEDINDATE, 120), '') AS CHECKEDINDATE, " +
		"ISNULL(L.REASONFORCHECKOUT, '') AS REASONFORCHECKOUT, " +
		"ISNULL(L.LANGID, '') AS LANGID, " +
		"CASE WHEN V.VERSIONID IS NULL THEN '' ELSE " +
		"CAST(ISNULL(V.MAJOR, 0) AS varchar(10)) + '.' + " +
		"CAST(ISNULL(V.MINOR, 0) AS varchar(10)) + '.' + " +
		"CAST(ISNULL(V.BUILD, 0) AS varchar(10)) END AS VERSIONTEXT " +
		"from LIMSSOURCECONTROL L " +
		"left join LIMSVERSIONS V on V.VERSIONID = L.VERSIONID " +
		"where L.ITEMID = ? " +
		"order by L.ORIGREC desc";

	aHistory := LSelect(sSQL,, "DICTIONARY", {sItemID});

	aItems := {};
	:IF !Empty(aHistory);
		:FOR i := 1 :TO Len(aHistory);
			aRow := aHistory[i];
			oItem := oUtils:RemoveDBNull(CreateUDObject({
				{"versionId", AllTrim(aRow[1])},
				{"done", AllTrim(aRow[2])},
				{"checkedOutBy", aRow[3]},
				{"checkedOutDate", aRow[4]},
				{"checkedInBy", aRow[5]},
				{"checkedInDate", aRow[6]},
				{"reason", aRow[7]},
				{"language", AllTrim(aRow[8])},
				{"versionText", aRow[9]}
			}));
			AAdd(aItems, oItem);
		:NEXT;
	:ENDIF;

	oResult := CreateUDObject({
		{"uri", sURI},
		{"items", aItems}
	});

	oResponse:success := .T.;
	oResponse:data := oResult;
:CATCH;
	:DECLARE Error;
	Error := GetLastSSLError();
	UsrMes("ERROR", Error:FullDescription);
	Response:StatusCode := 400;
	oResponse:success := .F.;
	oResponse:data := Error:FullDescription;
:ENDTRY;

Response:StatusCode := 200;
:RETURN oResponse;
