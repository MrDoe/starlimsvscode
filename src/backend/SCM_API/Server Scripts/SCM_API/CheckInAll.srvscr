/******************************************************************************
Description.. :	Check in all items currently checked out by current user
Author....... :	DC
Date......... : 2023-07-28
*******************************************************************************/;
:DECLARE oResponse, bAllUsers, aResult, ds, sReason, sItemID, i;
:DECLARE sBody, sRequestAsFile, oPayload, nErrors, nTotal, sErrorSummary;
:DECLARE sItemName, sItemType, sItemResponse, oItemError;
oResponse := CreateUDObject({
	{"success", .T.},
	{"data", NIL}
});

/* Read the check in reason from the JSON request body when the client announces
   one with the Body=1 parameter. VSCode sends long check in reasons in the body
   because they exceed the ASP.NET maxQueryStringLength (2048) of GET requests.
   The query string value is still accepted as a fallback for older clients;
oPayload := NIL;
sBody := "";
:IF Request:QueryString:IsProperty("Body");
	:TRY;
		sRequestAsFile := Request:SaveInputStream();
		:IF !Empty(sRequestAsFile);
			sBody := ReadText(sRequestAsFile);
			FileSupport(sRequestAsFile, "DELETE");
		:ENDIF;
		:IF !Empty(sBody);
			oPayload := FromJSON(sBody);
		:ENDIF;
	:CATCH;
		oPayload := NIL;
	:ENDTRY;
:ENDIF;

:IF !Empty(oPayload) .AND. oPayload:IsProperty("Reason");
	sReason := LimsString(oPayload:Reason);
:ENDIF;

:IF Empty(sReason) .AND. Request:QueryString:IsProperty("Reason");
	sReason := Request:QueryString:Reason;
:ENDIF;

:IF Request:QueryString:IsProperty("AllUsers");
    bAllUsers := Request:QueryString:AllUsers;
:ELSE;
    bAllUsers := .F.;
:ENDIF;

aResult := DoProc("Enterprise_Data_Providers.CheckInProvider.GetPendingCheckins", {bAllUsers});
ds := DoProc("Enterprise_Data_Providers.Utils.ConvertXMLStringToDataset", {aResult});

/* Check in every item on its own so that one failing item can neither abort the
   remaining items nor hide its error. CheckInItem returns an "Error ..." string
   for business errors and can also raise a runtime error;
nErrors := 0;
nTotal := ds:Tables[0]:Rows:Count;
sErrorSummary := "";
:FOR i:=0 :TO ds:Tables[0]:Rows:Count - 1;
	:DECLARE row;
	row := ds:Tables[0]:Rows[i];
	sItemID := LimsString(row["CHILDID"]);
	sItemType := LimsString(row["CHILDTYPE"]);
	sItemName := LimsString(row["CHILDNAME"]);
	sItemResponse := "";
	:TRY;
		sItemResponse := LimsString(DoProc("Enterprise_Data_Providers.CheckInProvider.CheckInItem", {sItemID, sItemType, NIL, sReason, NIL, .F.}));
	:CATCH;
		oItemError := GetLastSSLError();
		sItemResponse := "Error " + oItemError:FullDescription;
	:ENDTRY;
	:IF SubStr(sItemResponse, 1, 5) == "Error";
		nErrors := nErrors + 1;
		:IF nErrors <= 5;
			:IF !Empty(sErrorSummary);
				sErrorSummary := sErrorSummary + " | ";
			:ENDIF;
			sErrorSummary := sErrorSummary + sItemName + " (" + sItemType + "): " + sItemResponse;
		:ENDIF;
		UsrMes("ERROR", "Could not check in " + sItemName + ": " + sItemResponse);
	:ENDIF;
:NEXT;

Response:StatusCode := 200;
:IF nErrors == 0;
	oResponse:success := .T.;
	oResponse:data := "Checked in " + nTotal + " item(s).";
:ELSE;
	oResponse:success := .F.;
	oResponse:data := "Could not check in " + nErrors + " of " + nTotal + " item(s): " + sErrorSummary;
	:IF nErrors > 5;
		oResponse:data := oResponse:data + " | ...";
	:ENDIF;
:ENDIF;
:RETURN oResponse;
