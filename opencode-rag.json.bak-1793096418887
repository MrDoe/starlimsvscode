    "chunkOverlap": 0,
    "minFileSizeBytes": 0,
    "concurrency": 8,
    "embedBatchSize": 40,
    "embedConcurrency": 4,
    "ollamaMaxBatchSize": 40
  },
  "vectorStore": {
    "path": "./.opencode/rag_db"
  },
  "retrieval": {
    "topK": 20,
    "minScore": 0.35,
    "hybridSearch": {
      "enabled": true,
      "keywordWeight": 0.4
    }
  },
  "openCode": {
    "enabled": true,
    "maxContextChunks": 10,
    "readOverride": true,
    "autoIndex": {
      "enabled": true,
      "debounceMs": 2000,
      "intervalMs": 300000,
      "watcher": "chokidar"
    }
  },
  "imageDescription": {
    "enabled": true,
    "provider": "openai",
    "apiKey": "sk-llama-local",
    "model": "Ornith-1.5-9B",
    "baseUrl": "http://127.0.0.1:11437/v1",
    "timeoutMs": 60000,
    "think": false,
    "numCtx": 2048
  },
  "description": {
    "enabled": true,
    "provider": "openai",
    "apiKey": "sk-llama-local",
    "baseUrl": "http://127.0.0.1:11437/v1",
    "model": "Ornith-1.5-9B",
    "think": false,
    "numCtx": 4096,
    "timeoutMs": 60000,
    "maxContentChars": 4000
  },
  "wikiMode": {
    "enabled": true
  },
  "mcp": {
    "enabled": false
  },
  "logging": {
    "level": "info",
    "logFilePath": "./.opencode/opencode-rag.log"
  }
